/* ═══════════════════════════════════════════════════════════
   ANTORDRISHTI — Professional Forensic Analysis Stylesheet
   Light Theme | Segoe UI | Pure White Surfaces | High Contrast
   ═══════════════════════════════════════════════════════════ */

/* ── Global ─────────────────────────────────────────────── */
* {
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, "Roboto", "Helvetica Neue", Arial, sans-serif;
    font-size: 12px;
    color: #0F172A;
}

QMainWindow {
    background-color: #F1F5F9;
}

/* ── Menu Bar ───────────────────────────────────────────── */
QMenuBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
    padding: 3px 6px;
    font-size: 13px;
    color: #0F172A;
}

QMenuBar::item {
    padding: 5px 12px;
    background: transparent;
    border-radius: 4px;
    color: #0F172A;
    font-weight: 500;
}

QMenuBar::item:selected {
    background-color: #F1F5F9;
    color: #0D7C7C;
}

QMenuBar::item:pressed {
    background-color: #E2E8F0;
}

/* ── Menus ──────────────────────────────────────────────── */
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 4px 0px;
}

QMenu::item {
    padding: 6px 28px 6px 24px;
    min-width: 180px;
    color: #0F172A;
    font-size: 12px;
}

QMenu::item:selected {
    background-color: #F0FDFA;
    color: #0D7C7C;
    font-weight: 600;
}

QMenu::item:disabled {
    color: #94A3B8;
}

QMenu::separator {
    height: 1px;
    background-color: #E2E8F0;
    margin: 4px 8px;
}

/* ── Toolbar ────────────────────────────────────────────── */
QToolBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
    padding: 3px 6px;
    spacing: 4px;
}

QToolBar::separator {
    width: 1px;
    background-color: #E2E8F0;
    margin: 4px 6px;
}

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 5px 10px;
    font-size: 12px;
    font-weight: 500;
    color: #334155;
}

QToolButton:hover {
    background-color: #F1F5F9;
    border-color: #CBD5E1;
    color: #0F172A;
}

QToolButton:pressed {
    background-color: #E2E8F0;
}

QToolButton:checked {
    background-color: #E6F4F8;
    border-color: #0D7C7C;
    color: #0D7C7C;
}

/* ── Scroll Bars ────────────────────────────────────────── */
QScrollBar:vertical {
    background-color: #F8FAFC;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #CBD5E1;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #94A3B8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #F8FAFC;
    height: 8px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #CBD5E1;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #94A3B8;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
    width: 0px;
}

/* ── Push Buttons ───────────────────────────────────────── */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    padding: 5px 14px;
    font-size: 12px;
    color: #0F172A;
    min-height: 22px;
}

QPushButton:hover {
    background-color: #F1F5F9;
    border-color: #94A3B8;
    color: #000000;
}

QPushButton:pressed {
    background-color: #E2E8F0;
}

QPushButton:disabled {
    background-color: #F8FAFC;
    color: #94A3B8;
    border-color: #E2E8F0;
}

QPushButton[primary="true"] {
    background-color: #0D7C7C;
    color: #FFFFFF;
    border: 1px solid #0B6B6B;
    font-weight: 600;
}

QPushButton[primary="true"]:hover {
    background-color: #0A6666;
}

QPushButton[primary="true"]:pressed {
    background-color: #085555;
}

QPushButton[danger="true"] {
    background-color: #FFFFFF;
    color: #DC2626;
    border: 1px solid #FCA5A5;
    font-weight: 600;
}

QPushButton[danger="true"]:hover {
    background-color: #FEF2F2;
    border-color: #DC2626;
}

/* ── Line Edit ──────────────────────────────────────────── */
QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
    color: #0F172A;
    min-height: 22px;
    selection-background-color: #E6F4F8;
    selection-color: #0F172A;
}

QLineEdit:focus {
    border: 1px solid #0D7C7C;
}

/* ── Combo Box ──────────────────────────────────────────── */
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    padding: 4px 10px;
    min-height: 22px;
    font-size: 12px;
    color: #0F172A;
}

QComboBox:hover {
    border-color: #94A3B8;
}

QComboBox:focus {
    border: 1px solid #0D7C7C;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #475569;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    padding: 4px;
    color: #0F172A;
    selection-background-color: #F0FDFA;
    selection-color: #0D7C7C;
}

/* ── Slider ─────────────────────────────────────────────── */
QSlider::groove:horizontal {
    height: 4px;
    background-color: #CBD5E1;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: #0D7C7C;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #0D7C7C;
    border: 2px solid #FFFFFF;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background-color: #0A6666;
}

/* ── Tab Widget ─────────────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid #E2E8F0;
    background-color: #FFFFFF;
    border-radius: 0px 0px 6px 6px;
}

QTabBar::tab {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-bottom: none;
    padding: 8px 16px;
    margin-right: 2px;
    font-size: 12px;
    font-weight: 500;
    color: #475569;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #0D7C7C;
    font-weight: 700;
    border-bottom: 2px solid #0D7C7C;
}

QTabBar::tab:hover:!selected {
    background-color: #F1F5F9;
    color: #0F172A;
}

/* ── Status Bar ─────────────────────────────────────────── */
QStatusBar {
    background-color: #F8FAFC;
    border-top: 1px solid #E2E8F0;
    font-size: 11px;
    color: #475569;
    min-height: 26px;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    padding: 0px 6px;
    font-size: 11px;
    color: #334155;
    font-weight: 500;
}

/* ── Splitter ───────────────────────────────────────────── */
QSplitter::handle {
    background-color: #E2E8F0;
}

QSplitter::handle:hover {
    background-color: #0D7C7C;
}

/* ── Scroll Area ────────────────────────────────────────── */
QScrollArea {
    background-color: transparent;
    border: none;
}
